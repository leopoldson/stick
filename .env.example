# Copy to .env for local runs. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Any long random strings:
WEBHOOK_SECRET=
TICK_KEY=
# Local default is SQLite. On Render, paste your Postgres "Internal Database URL".
DATABASE_URL=sqlite:///./stick.db
# Only needed for app.set_webhook, e.g. https://stick-bot.onrender.com
PUBLIC_URL=

# ---- WhatsApp (optional; see WHATSAPP_SETUP.md) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
PRIVACY_CONTACT=
